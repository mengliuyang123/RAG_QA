# 专用 PostgreSQL 应用库与独立测试库；均需预先启用 vector 扩展。
DATABASE_URL=postgresql://rag_user:replace-with-password@127.0.0.1:5432/rag_qa
TEST_DATABASE_URL=postgresql://rag_user:replace-with-password@127.0.0.1:5432/rag_qa_postgres_test
DATABASE_SCHEMA=rag_qa
EVALUATION_DATABASE_SCHEMA=rag_qa_evaluation
OPENAI_API_KEY=your-api-key
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# docker compose 使用的数据库密码
POSTGRES_PASSWORD=replace-with-password
# 部署：浏览器访问用的公网 IP 或域名；纯 HTTP 访问时关闭 Secure Cookie
PUBLIC_HOST=localhost
AUTH_SECURE_COOKIE=true
# 国内构建镜像时可改为阿里云/npmmirror 镜像
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# NPM_REGISTRY=https://registry.npmmirror.com
